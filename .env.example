# Supabase project URL and anon (public) key — safe to expose to the
# browser. Find these in Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER-ONLY, bypasses Row Level Security.
# Never prefix with NEXT_PUBLIC_. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Full site URL, no trailing slash. Used for email confirmation redirects,
# ICS event links, and building referral link URLs.
# Local dev: http://localhost:3000
# Production: https://iurugby.com (or your Vercel URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
